# Required only for screenshot recognition (calendar + BigTime project screenshots).
# Everything else (calendar file import, manual entry, CSV export) works without it.
# Server-side only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional: override the vision model (defaults to claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional but recommended when the site is public: a shared access code that
# coworkers must enter before screenshot recognition will run (protects your API credits).
# APP_ACCESS_CODE=
